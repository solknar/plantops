# Free key from https://aistudio.google.com/apikey (no billing account needed)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Models (see https://ai.google.dev/gemini-api/docs/pricing for free-tier availability)
PLANTOPS_WORKER_MODEL=gemini-3.5-flash-lite
PLANTOPS_STRONG_MODEL=gemini-3.8-flash
PLANTOPS_EMBED_MODEL=gemini-embedding-2
# Tried in order when a model is overloaded (503) or out of quota (429)
PLANTOPS_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite

# "gemini" for real embeddings, "hash" for a fully offline keyword-hashing embedder
PLANTOPS_EMBEDDER=gemini

# "inprocess" calls tools directly; "mcp" routes them through the PlantOps MCP server (stdio)
PLANTOPS_TOOL_TRANSPORT=inprocess

# Max critic/refiner passes in the self-reflection loop
PLANTOPS_MAX_REFLECTIONS=2

# Where runtime state lives (vector DB, SQLite warehouse, sessions, traces, metrics)
PLANTOPS_VAR_DIR=var
